# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GUARDIAN_CHAT_ID=

# Model routing (exact IDs fixed in the SRD from the provider pricing page)
ALLY_DIALOGUE_MODEL=
ALLY_VERIFY_MODEL=
ALLY_DIALOGUE_EFFORT=high

# Privacy switches
ALLY_TEXT_ONLY_VERIFY=false
ALLY_BLUR_FACE_FOR_GUARDIAN=true
ALLY_KEYFRAME_RETENTION_DAYS=7

# Runtime
ALLY_CAPTURE_WIDTH=640
ALLY_CAPTURE_HEIGHT=480
ALLY_INACTIVITY_MINUTES=30
# 127.0.0.1 = this laptop only. To let a co-resident carer view it, set the laptop LAN IP (e.g. 192.168.x.x) — never 0.0.0.0.
ALLY_DASHBOARD_BIND=127.0.0.1
ALLY_DASHBOARD_TOKEN=
